# Optional client-to-gateway key. When set, callers must send Authorization: Bearer <key>.
GATEWAY_API_KEY=

# Optional scoped admin keys. Configure matching entries under security.admin_api_keys
# in config.yaml. Add a replacement key before disabling the old entry to rotate.
# GATEWAY_FINANCE_KEY=
# GATEWAY_OPERATIONS_KEY=

# Override defaults from config.yaml
GATEWAY_CONFIG=config.yaml
GATEWAY_DATABASE=./gateway.sqlite3

# Optional HMAC key when a budget policy references this variable in
# alert_webhook_secret_env. Replace with a secret from your secret manager.
# LLM_BUDGET_WEBHOOK_SECRET=

# Optional shared backends for multi-replica deployments.
# Example: postgresql://gateway:password@localhost:5432/llm_gateway
# GATEWAY_DATABASE=postgresql://gateway:password@localhost:5432/llm_gateway
# Example: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
